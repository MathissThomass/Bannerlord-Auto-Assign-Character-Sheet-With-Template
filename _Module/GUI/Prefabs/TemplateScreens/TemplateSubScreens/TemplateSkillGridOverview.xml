<Prefab>
    <Constants>
    </Constants>
    <VisualDefinitions>
    </VisualDefinitions>


    <Window>

        <GridWidget Id="SkillGrid" DataSource="{SkillsVm}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" DefaultCellWidth="42"
                    DefaultCellHeight="42" ColumnCount="7">
            <ItemTemplate>
                <SkillIconVisualWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40"
                                       SuggestedHeight="40" SkillId="@SkillId" MarginBottom="2" UseSmallVariation="true"
                                       MarginLeft="2">
                    <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20"
                                    Text="Important Skill" VerticalAlignment="Center" Brush="Encyclopedia.Skill.Text"
                                    Brush.FontSize="20" Brush.FontColor="#FCB066FF" IsVisible="@IsImportantSkill"/>

                        <HintWidget DataSource="{Hint}" HeightSizePolicy="StretchToParent"
                                    WidthSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint"
                                    Command.HoverEnd="ExecuteEndHint"/>
                    </Children>
                </SkillIconVisualWidget>
            </ItemTemplate>
        </GridWidget>

    </Window>
</Prefab>
